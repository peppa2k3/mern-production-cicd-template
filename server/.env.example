# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
WEB_PORT=8080

# Database
MONGO_URI=mongodb://localhost:27017/affiliate_platform

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES=30d

# Cookie
COOKIE_SECRET=change_this_cookie_secret

# Upload
UPLOAD_STORAGE=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# Compose selects MinIO; direct Node development defaults to disk.
# Optional MINIO_IMAGE override; Compose defaults to the official pinned release.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=affiliate-local
MINIO_SECRET_KEY=change_this_minio_secret
MINIO_BUCKET=affiliate-files

# Rate limit
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300

# Redis (optional - leave blank to disable cache layer)
REDIS_URL=

# Super Admin seed
SUPER_ADMIN_EMAIL=admin@affiliate.local
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
