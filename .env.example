# Production only: copy to <deploy-root>/shared/server.env on VPS (chmod 600).
APP_NAME=affiliate-app
APP_DOMAIN=affiliate.example.com
API_DOMAIN=api.affiliate.example.com
TRAEFIK_NETWORK=web
STORAGE_NETWORK=shared_storage
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=https://affiliate.example.com
TRUST_PROXY_HOPS=1
MONGO_URI=mongodb://shared-mongo:27017/affiliate_platform
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=30d
COOKIE_SECRET=
UPLOAD_STORAGE=minio
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
MINIO_ENDPOINT=shared-minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=affiliate-files
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
