# Copy this file to `.env` ON THE VPS ONLY and fill in real values there.
# .env is never committed, never synced by CI, and never baked into a
# Docker image — see docs/deployment.md.

# ---- App identity (used for Traefik routing labels) ----
APP_NAME=myapp
APP_DOMAIN=myapp.example.com
TRAEFIK_NETWORK=traefik_proxy

# ---- Image source ----
# GHCR_OWNER/GHCR_REPO must be lowercase (GHCR requirement).
# IMAGE_TAG is set automatically by deploy.sh at deploy time — the value
# here is only used if you run `docker compose` manually without it set.
GHCR_OWNER=your-github-org-or-user
GHCR_REPO=your-repo-name
IMAGE_TAG=latest

# ---- Runtime configuration (build-time vs runtime — see docs) ----
NODE_ENV=production
PORT=3000

# ---- Secrets — set real values directly on the VPS. Never commit them. ----
MONGO_URI=mongodb://mongo:27017/myapp
JWT_SECRET=
SESSION_SECRET=
